{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "types",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020"
  },
  "include": ["lib/**/*.js", "lib/**/*.d.ts"],
  "exclude": ["node_modules", "tests"]
}
